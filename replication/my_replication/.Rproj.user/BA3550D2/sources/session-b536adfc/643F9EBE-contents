# Table A8: Manipulation Check - group association by treatment condition
groups <- c(
  "mc2_latinos", "mc2_muslims", "mc2_western_europeans", "mc2_africans",
  "mc2_eastern_europeans", "mc2_me_na", "mc2_mexicans", "mc2_americans",
  "mc2_woman", "mc2_asians", "mc2_whites", "mc2_blacks", "mc2_men")

get_yes_count_by_treatment <- function(variable, label) {
  df_treated %>%
    filter(!!sym(variable) == "Y") %>%
    count(treatment) %>% 
    mutate(group = label) %>%
    select(group, treatment, n)
}

result <- map_dfr(groups, ~ get_yes_count_by_treatment(.x, .x))

result_df <- result %>%
  pivot_wider(names_from = treatment, 
              values_from = n, 
              values_fill = 0) %>%
  mutate(group = recode(group,
                        "mc2_latinos" = "Latinos",
                        "mc2_muslims" = "Muslims",
                        "mc2_western_europeans" = "Western Europeans",
                        "mc2_africans" = "Africans",
                        "mc2_eastern_europeans" = "Eastern Europeans",
                        "mc2_me_na" = "Middle Eastern/North Africans",
                        "mc2_mexicans" = "Mexicans",
                        "mc2_americans" = "Americans",
                        "mc2_woman" = "Women",
                        "mc2_asians" = "Asians",
                        "mc2_whites" = "Whites",
                        "mc2_blacks" = "Blacks",
                        "mc2_men" = "Men")) %>%
  mutate(Total = t1 + t2 + t3 + t4) %>%  
  arrange(desc(Total))

datasummary_df(result_df, 
               title = "Manipulation check group associations by treatment condition", 
               note = "Number of respondents who selected the named group when asked: While reading the interview with the politician, which of the following groups of people did you intuitively think about? Several answer options are possible. Counts shown by treatment condition.", 
               fmt = function(x) sprintf("%.0f", x),
               output = "markdown")

rm(result, result_df, groups, get_yes_count_by_treatment)


