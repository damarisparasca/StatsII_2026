cat("Calculating additional robustness tests: \n")
cat("Calculating differences between value and safety threats with group association (Muslim - Latino)\n")
cat("These results are described in the discussion in the text, these tables are not listed in the Appendix.\n")

## -- Robustness test 3 (mentioned in paper) 
## -- Differences between value and safety threats with group association (Muslim - Latino)

df_treated <- df %>%
  filter(treatment != "control")

df_treated <- df_treated %>%
  mutate(threat_type = case_when(
    treatment %in% c("t1", "t3") ~ "Value-threat",
    treatment %in% c("t2", "t4") ~ "Safety-threat"
  ))

threat_sizes <- df_treated %>%
  count(threat_type) %>%
  deframe()

print("Sample sizes by threat type:")
print(threat_sizes)

### -- Muslim test
muslims_summary <- df_treated %>%
  group_by(threat_type) %>%
  summarise(
    n_total = n(),
    n_mentioned = sum(mc2_muslims == "Y", na.rm = TRUE),
    n_not_mentioned = n_total - n_mentioned,
    prop_mentioned = n_mentioned / n_total
  ) %>%
  mutate(group = "Muslims")

print("Muslims by threat type:")
print(muslims_summary)

# Create contingency table for chi-square
muslims_table <- muslims_summary %>%
  select(threat_type, n_mentioned, n_not_mentioned) %>%
  column_to_rownames("threat_type") %>%
  as.matrix()

print("Muslims contingency table:")
print(muslims_table)

muslims_chisq <- chisq.test(muslims_table)
print("Muslims chi-square test:")
print(muslims_chisq)

### -- Latinos test
latinos_summary <- df_treated %>%
  group_by(threat_type) %>%
  summarise(
    n_total = n(),
    n_mentioned = sum(mc2_latinos == "Y", na.rm = TRUE),
    n_not_mentioned = n_total - n_mentioned,
    prop_mentioned = n_mentioned / n_total
  ) %>%
  mutate(group = "Latinos")

print("Latinos by threat type:")
print(latinos_summary)


### -- Chi-square tests
latinos_table <- latinos_summary %>%
  select(threat_type, n_mentioned, n_not_mentioned) %>%
  column_to_rownames("threat_type") %>%
  as.matrix()

print("Latinos contingency table:")
print(latinos_table)

latinos_chisq <- chisq.test(latinos_table)
print("Latinos chi-square test:")
print(latinos_chisq)

### --  Summary table 
results_long <- bind_rows(
  muslims_summary %>% 
    mutate(chi_sq = muslims_chisq$statistic, 
           p_value = muslims_chisq$p.value),
  latinos_summary %>% 
    mutate(chi_sq = latinos_chisq$statistic, 
           p_value = latinos_chisq$p.value)
) %>%
  mutate(
    significance = case_when(
      p_value < 0.001 ~ "***",
      p_value < 0.01 ~ "**",
      p_value < 0.05 ~ "*",
      TRUE ~ ""
    )
  )

print("Summary Results Table (Long Format):")
print(results_long)

results_wide <- results_long %>%
  select(group, threat_type, n_mentioned, n_total, prop_mentioned) %>%
  pivot_wider(
    names_from = threat_type,
    values_from = c(n_mentioned, n_total, prop_mentioned),
    names_glue = "{threat_type}_{.value}"
  ) %>%
  mutate(
    chi_squared = c(muslims_chisq$statistic, latinos_chisq$statistic),
    df = 1,
    p_value = c(muslims_chisq$p.value, latinos_chisq$p.value),
    sig = c(
      ifelse(muslims_chisq$p.value < 0.001, "***",
             ifelse(muslims_chisq$p.value < 0.01, "**",
                    ifelse(muslims_chisq$p.value < 0.05, "*", ""))),
      ifelse(latinos_chisq$p.value < 0.001, "***",
             ifelse(latinos_chisq$p.value < 0.01, "**",
                    ifelse(latinos_chisq$p.value < 0.05, "*", "")))
    )
  ) %>%
  rename(
    Group = group,
    `Safety N` = `Safety-threat_n_mentioned`,
    `Safety Total` = `Safety-threat_n_total`, 
    `Safety %` = `Safety-threat_prop_mentioned`,
    `Value N` = `Value-threat_n_mentioned`,
    `Value Total` = `Value-threat_n_total`,
    `Value %` = `Value-threat_prop_mentioned`,
    `χ²` = chi_squared,
    `p` = p_value
  )

print("Summary Results Table (Wide Format):")
print(results_wide)

